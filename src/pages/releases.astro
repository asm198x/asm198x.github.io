---
/**
 * What changed across versions.
 *
 * The third of the three artefacts the docs plan settles, and the one the other
 * two do not answer. The version label says which binary these pages describe;
 * the GitHub release says what is in the one you are about to install; this says
 * whether it is worth upgrading.
 *
 * Everything comes from the assembler's own changelog, at the released tag, so
 * the page can only ever describe releases that exist. Install commands are
 * deliberately absent — `/docs/cli/` carries unpinned ones that never go stale,
 * and version-pinned ones belong on the release they document.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { documentedVersion } from '@lib/version';

const entries = await getCollection('releases');

// Newest first. Versions are dotted numbers, so compare them as numbers rather
// than as strings — otherwise 0.0.9 sorts above 0.0.18.
const parts = (v: string) => v.split('.').map((n) => Number.parseInt(n, 10) || 0);
const releases = entries.sort((a, b) => {
  const [x, y] = [parts(b.data.version), parts(a.data.version)];
  for (let i = 0; i < Math.max(x.length, y.length); i++) {
    if ((x[i] ?? 0) !== (y[i] ?? 0)) return (x[i] ?? 0) - (y[i] ?? 0);
  }
  return 0;
});

const rendered = await Promise.all(
  releases.map(async (entry) => ({
    ...entry.data,
    Content: (await render(entry)).Content,
  })),
);

// `documentedVersion()` returns `v0.0.18`; the changelog headings say `0.0.18`.
const documented = documentedVersion()?.replace(/^v/, '') ?? null;
---

<BaseLayout
  title="Releases"
  description="asm198x release history — what changed in each version, from the assembler's own changelog."
>
  <div class="container releases">
    <header>
      <p class="eyebrow">Releases</p>
      <h1>What changed, and whether to upgrade.</h1>
      <p class="lede">
        Every version, from the changelog the assembler ships. Downloads and
        install commands are on each{' '}
        <a href="https://github.com/asm198x/asm198x/releases">GitHub release</a>.
      </p>
    </header>

    {
      rendered.length === 0 ? (
        <p class="unavailable">
          This build could not read the changelog from the release it documents.
        </p>
      ) : (
        <ol class="list">
          {rendered.map((release) => (
            <li class:list={['release', { documented: release.version === documented }]}>
              <div class="meta">
                <h2>
                  {release.url ? (
                    <a href={release.url}>{release.version}</a>
                  ) : (
                    release.version
                  )}
                </h2>
                {release.date && <p class="date">{release.date}</p>}
                {release.version === documented && (
                  <p class="badge">These pages describe it</p>
                )}
              </div>
              <div class="prose">
                <release.Content />
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<style>
  .releases {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .lede {
    max-width: 46rem;
    margin: 0 0 3rem;
    color: var(--ink-muted);
    font-family: var(--font-read);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .release {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: 2.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }

  .meta {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .meta h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .meta h2 a {
    color: inherit;
    text-decoration: none;
  }

  .meta h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .date {
    margin: 0.2rem 0 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .badge {
    display: inline-block;
    margin: 0.6rem 0 0;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  /* The prose rules give `h2` a rule above it, which is right inside a page and
   * wrong for a changelog's `### Added`. These entries carry their own heading
   * in the left column. */
  .release .prose :global(h3) {
    margin-top: 1.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .release .prose :global(> :first-child) {
    margin-top: 0;
  }

  .unavailable {
    color: var(--ink-soft);
  }

  @media (max-width: 55rem) {
    .release {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .meta {
      position: static;
    }
  }
</style>
