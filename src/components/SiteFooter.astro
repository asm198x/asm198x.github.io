---
/**
 * The family strip is shared and its wording is fixed by
 * 198x/decisions/sibling-cross-promotion.md — siblings as peers, the hub
 * linked, each name pointing at its GitHub org.
 */
import FamilyStrip from '@198x-ui/components/FamilyStrip.astro';

const year = 2026;
---

<footer class="site-footer">
  <FamilyStrip />
  <div class="container legal">
    <span>© {year} · GPL-2.0-or-later</span>
    <a href="https://github.com/asm198x">GitHub</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--line);
    padding: 2rem 0 calc(2rem + env(safe-area-inset-bottom));
    background: var(--paper-strong);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  p {
    max-width: 720px;
    margin: 0;
    font-size: 0.94rem;
  }

  .footer-inner > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
    font-weight: 650;
  }

  p a {
    font-weight: 650;
  }

  .legal {
    margin-top: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  @media (max-width: 680px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
