---
/**
 * The family strip is shared and its wording is fixed by
 * 198x/decisions/sibling-cross-promotion.md — siblings as peers, the hub
 * linked, each name pointing at its GitHub org. It draws the footer's only
 * rule; nothing here should draw a second one.
 *
 * The list omits Asm198x: pointing a reader at the site they are already on is
 * noise, and the strip exists to show them the rest of the family.
 */
import FamilyStrip from '@198x-ui/components/FamilyStrip.astro';

const siblings = [
  { name: 'Code198x', href: 'https://code198x.com' },
  { name: 'Emu198x', href: 'https://emu198x.github.io' },
  { name: 'Cat198x', href: 'https://github.com/cat198x' },
];

const year = 2026;
---

<footer class="site-footer">
  <FamilyStrip siblings={siblings} />
  <div class="legal">
    <span>© {year} · GPL-2.0-or-later</span>
    <a href="https://github.com/asm198x">GitHub</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: var(--h-ground);
  }

  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Same inset the shared strip uses, so the two rows agree. */
    padding: 0 var(--h-inset) calc(1rem + env(safe-area-inset-bottom));
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .legal a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink-muted);
    text-decoration: none;
    text-underline-offset: 0.18em;
  }

  .legal a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .legal a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
