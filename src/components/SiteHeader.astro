---
/**
 * This site's nav. The furniture is shared (198x-ui); the routes are not — a
 * shared nav that knew them would have to be edited to add a page here.
 */
import SiteNav from '@198x-ui/components/SiteNav.astro';

interface Props {
  /** Marks the current section, matched against an item label. */
  current?: string;
  /** The version this site documents, already labelled. Null while unknown. */
  version?: string | null;
}

const { current, version } = Astro.props;

const items = [
  { label: 'Why', href: '/#why' },
  { label: 'CPUs', href: '/#cpus' },
  { label: 'Install', href: '/#install' },
  // Built from the assembler's own repo by the Pages workflow, so it describes
  // the released binary rather than this site's last deploy.
  { label: 'Docs', href: '/docs/' },
  // The version at the end of this nav is the natural place to link this from,
  // but it lives in the shared component and only this site has the page.
  // Revisit when another family site grows one.
  { label: 'Releases', href: '/releases/' },
  { label: 'GitHub', href: 'https://github.com/asm198x' },
].map((item) => ({ ...item, current: item.label === current }));
---

<SiteNav prefix="asm" project="asm" items={items} version={version ?? undefined} />
